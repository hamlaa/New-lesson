# ─── NEW LESSON website settings ─────────────────────────────────────
# Copy this file to `.env` and edit. docker compose reads `.env` automatically.

# Your real public address (no trailing slash). Used for canonical URLs,
# sitemap.xml, robots.txt, Open Graph previews and structured data.
# ⚠️ Baked in at build time → rebuild after changing: docker compose up -d --build
NEXT_PUBLIC_SITE_URL=https://newlesson-kosamui.example.com

# Google Search Console → "HTML tag" verification code (only the content="..." value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set to true on test/staging servers so Google does NOT index them
NEXT_PUBLIC_NOINDEX=false

# Port on the host machine
APP_PORT=3080

# Only for the optional HTTPS proxy (docker compose --profile https up -d)
DOMAIN=newlesson-kosamui.example.com
