# Automatic HTTPS for the NEW LESSON website (used by: docker compose --profile https up -d)
# DOMAIN comes from .env, e.g. DOMAIN=newlesson-kosamui.com

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# Optional: send www → main domain (one address = better for Google).
# Uncomment only if a DNS record for www.<domain> also points to this server.
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
